# Your school's Brightspace host
D2L_HOST=brightspace.example.edu

# Shared secret the app sends as "Authorization: Bearer <API_KEY>". Leave empty only for local testing.
API_KEY=

# Optional: lets the server sign in without a window (MFA still needs `npm run login`)
D2L_USERNAME=
D2L_PASSWORD=

# PORT=3100

# Where the login cookies are saved (default ~/.d3l-cookies.json)
# D2L_COOKIE_FILE=
