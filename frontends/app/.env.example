# For running the app directly (see README.md). In Docker, docker-compose.yml fills in the
# database and service addresses.

# Where you open the app. Google must list <this>/login/callback as an authorized redirect URI.
APP_PUBLIC_URL=http://localhost:3500
# Signs the login cookie: openssl rand -hex 32
APP_SECRET_KEY=

# Shown on the privacy and terms pages as who to contact. Optional.
# APP_CONTACT_EMAIL=

DATABASE_URL=postgresql://sumirrorize:<POSTGRES_PASSWORD>@localhost:5432/sumirrorize

# From the Google Cloud Console (APIs & Services -> Credentials -> OAuth client ID, "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts saved Google Calendar tokens. The mirror backend needs the same value.
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_KEY=
# Ask for calendar access at every sign-in instead of only from the Connect button. Leave off
# while the Google app is in testing, or people who aren't listed testers can't sign in.
# GOOGLE_CALENDAR_AT_SIGN_IN=true

# d3l: its address from the app, its SERVICE_API_KEY, and its address from people's browsers.
D3L_URL=http://localhost:3100
D3L_SERVICE_KEY=
D3L_PUBLIC_URL=http://localhost:3100

FACES_URL=http://localhost:3400
FACES_API_KEY=
