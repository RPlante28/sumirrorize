# The same value as SERVICE_API_KEY in backends/d3l/.env
D3L_SERVICE_KEY=

# Where the mirror is, for deciding what "today" means.
# MIRROR_TIMEZONE=America/New_York

# Filled in by docker-compose.yml. Set these only when running outside Docker:
# DATABASE_URL=postgresql://sumirrorize:<password>@localhost:5432/sumirrorize
# D3L_URL=http://localhost:3100
# WEATHER_URL=http://localhost:3200
# FACES_URL=http://localhost:3400
# FACES_API_KEY=<same as the faces service>

# Blink check cutoffs on the 0-1 eye score (see README).
# MIRROR_EYES_OPEN_AT=0.7
# MIRROR_EYES_CLOSED_AT=0.45

# Google Calendar in the calendar widget (optional). Same three values as frontends/app/.env.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_KEY=
