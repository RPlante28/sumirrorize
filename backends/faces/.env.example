# What the mirror backend and sign-up app send. At least 32 characters: openssl rand -hex 32
FACES_API_KEY=

# Filled in by docker-compose.yml. Set these only when running outside Docker:
# DATABASE_URL=postgresql://sumirrorize:<password>@localhost:5432/sumirrorize
# FACES_MODELS_DIR=./models          (download with ./download-models.sh)

# How alike two faces must be to count as the same person (0-1). Higher = stricter.
# FACES_MATCH_THRESHOLD=0.363
