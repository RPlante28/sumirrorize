# Your school's Brightspace host
D2L_HOST=brightspace.example.edu

# The other sites signing in passes through: your school's login site, and its second step if it
# has one (e.g. Duo). Comma-separated; each covers its subdomains. The sign-in browser won't open
# pages anywhere else. For Marist: marist.edu,duosecurity.com
SIGN_IN_HOSTS=

# The Sumirrorize database (see db/README.md). With `docker compose --profile d3l up`
# this is filled in for you.
DATABASE_URL=postgresql://sumirrorize:<password>@localhost:5432/sumirrorize

# Lets a trusted backend (the mirror) read any person's data by also sending
# "X-Person-Id: <person_id>". At least 32 characters: openssl rand -base64 32
SERVICE_API_KEY=

# Encrypts saved Brightspace logins in the database. Changing it signs everyone out.
# openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# PORT=3100
