# Your school's Brightspace host
D2L_HOST=brightspace.example.edu

# Other sites a sign-in passes through (school login, Duo), comma-separated, subdomains included.
# The sign-in browser won't open pages anywhere else. For Marist: marist.edu,duosecurity.com
SIGN_IN_HOSTS=

# The Sumirrorize database (see db/README.md). `docker compose --profile d3l up` fills this in.
DATABASE_URL=postgresql://sumirrorize:<password>@localhost:5432/sumirrorize

# Lets a trusted backend read any person's data by also sending "X-Person-Id: <person_id>".
# At least 32 characters: openssl rand -base64 32
SERVICE_API_KEY=

# Encrypts saved Brightspace logins in the database. Changing it signs everyone out.
# openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# PORT=3100
