# Local database (docker-compose.yml). Any password works locally.
POSTGRES_PASSWORD=

# Change if something else on your machine already uses 5432.
# DB_PORT=5432

# How the apps connect to it:
# DATABASE_URL=postgresql://sumirrorize:<POSTGRES_PASSWORD>@localhost:5432/sumirrorize

# Weather service: where the mirror is (default: Marist College).
# WEATHER_LATITUDE=41.7225
# WEATHER_LONGITUDE=-73.9343
# WEATHER_LABEL=Poughkeepsie, NY
# WEATHER_PORT=3200
